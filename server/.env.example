# ============================================================
# Luxe Listings — Server Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is in .gitignore.
# ============================================================

# ------------------------------------------------------------
# MongoDB Atlas
# ------------------------------------------------------------
# Get this from: https://cloud.mongodb.com
# Steps: Create free cluster → Connect → Drivers → copy URI
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/listing?retryWrites=true&w=majority

# ------------------------------------------------------------
# Resend — Transactional Email
# ------------------------------------------------------------
# Sign up at https://resend.com (free: 3,000 emails/month)
# Create an API key under API Keys in the dashboard
# For local dev you can use the sandbox (no domain needed):
#   FROM will be: onboarding@resend.dev
# For production, verify your domain in Resend and update EMAIL_FROM
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The "from" address shown to recipients
# Use onboarding@resend.dev for sandbox testing
# Use your verified domain in production: Listings <hello@yourdomain.com>
EMAIL_FROM=Luxe Listings <onboarding@resend.dev>

# Where host notifications are delivered (your inbox)
EMAIL_TO=your-email@gmail.com

# ------------------------------------------------------------
# iCal Feed URLs — Airbnb, Vrbo, Booking.com (7br + 6br)
# ------------------------------------------------------------
ICAL_AIRBNB_7BR_URL=https://www.airbnb.com/calendar/ical/YOUR_LISTING_ID.ics?t=YOUR_TOKEN
ICAL_AIRBNB_6BR_URL=https://www.airbnb.com/calendar/ical/YOUR_LISTING_ID.ics?t=YOUR_TOKEN
ICAL_VRBO_7BR_URL=http://www.vrbo.com/icalendar/YOUR_TOKEN.ics?nonTentative
ICAL_VRBO_6BR_URL=http://www.vrbo.com/icalendar/YOUR_TOKEN.ics?nonTentative
ICAL_BOOKING_7BR_URL=https://ical.booking.com/v1/export?t=YOUR_TOKEN
ICAL_BOOKING_6BR_URL=https://ical.booking.com/v1/export?t=YOUR_TOKEN

# ------------------------------------------------------------
# CORS — Allowed frontend origin
# ------------------------------------------------------------
CLIENT_ORIGIN=http://localhost:3000

# ------------------------------------------------------------
# Server port
# ------------------------------------------------------------
PORT=3001
